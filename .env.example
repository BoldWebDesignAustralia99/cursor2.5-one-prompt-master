# Gumbo Connect v2 — frontend environment.
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# These are the only values the browser needs; all privileged keys live in
# Supabase / Vercel server-side env, never in the repo (Architecture 01 §4).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Mapbox token for clinic-match distance/travel-time + 3D map (persona 04).
VITE_MAPBOX_TOKEN=

# Optional: app environment label shown in the UI ("local" | "preview" | "production").
VITE_APP_ENV=local
